{
    "pipelines": [
        {
            "entity": "trade",
            "target": "postgresql",
            "queue_config": {
                "high_watermark": 16,
                "low_watermark": 8,
                "max_free_segments": 2,
                "segment_capacity": 1024
            },
            "export_config": {
                "host": "db.example.com",
                "port": 5432,
                "database": "trading",
                "user": "exporter",
                "password": "your_password",
                "table": "trades_export",
                "cursor_table": "trades_export_cursor",
                "sender_id": 1,
                "max_batch_size": 1024,
                "batch_timeout_ms": 100,
                "retry_initial_delay_ms": 500,
                "retry_max_delay_ms": 30000
            }
        }
    ]
}
